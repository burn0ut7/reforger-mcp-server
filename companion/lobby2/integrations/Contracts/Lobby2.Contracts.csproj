<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Lobby2.Contracts</PackageId>
    <Version>1.1.3</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Canonical Lobby2 data contracts and L2TB codec.</Description>
    <RepositoryUrl>https://github.com/burn0ut7/Lobby2</RepositoryUrl>
    <PathMap>$(MSBuildProjectDirectory)=/_/Contracts</PathMap>
  </PropertyGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>


